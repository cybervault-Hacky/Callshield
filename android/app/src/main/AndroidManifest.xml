<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No CAMERA, MICROPHONE, LOCATION, SMS, CONTACTS, STORAGE -->
    <!-- Only call-screening related role is requested via system dialog, not manifest permission -->

    <application
        android:allowBackup="false"
        android:label="CallShield Bridge"
        android:theme="@android:style/Theme.NoDisplay"
        android:icon="@android:drawable/sym_def_app_icon">

        <!-- Minimal no-UI activity for system requirements (optional) -->
        <activity
            android:name=".BridgeSetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- CallScreeningService — the only privileged component -->
        <service
            android:name=".CallShieldScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
